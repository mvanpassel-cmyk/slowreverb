{
  "name": "slowreverb-studio",
  "productName": "SlowReverb Studio",
  "version": "2.0.0",
  "description": "Slowed + reverb audio studio",
  "main": "main.js",
  "author": "Mark van Passel",
  "license": "MIT",
  "scripts": {
    "copy": "rm -rf app && mkdir -p app/vendor && cp ../index.html app/ && (cp ../vendor/lame.min.js app/vendor/ 2>/dev/null || curl -sSL https://cdn.jsdelivr.net/npm/lamejs@1.2.1/lame.min.js -o app/vendor/lame.min.js)",
    "start": "npm run copy && electron .",
    "build": "npm run copy && electron-packager . 'SlowReverb Studio' --platform=darwin --arch=arm64 --icon=icon.icns --app-bundle-id=nl.mvanpassel.slowreverb --extend-info=extend-info.plist --out=dist --overwrite --ignore='^/dist' --ignore='^/build\\.sh'"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.2"
  }
}
